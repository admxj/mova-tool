{
  "name": "tmc-tool",
  "version": "1.0.0",
  "description": "TMC 机票 / 酒店 查询、下单、支付桌面调试工具",
  "productName": "TMC调试工具",
  "main": "main.js",
  "scripts": {
    "prestart": "node scripts/set-macos-app-name.js",
    "start": "electron .",
    "presmoke": "node scripts/set-macos-app-name.js",
    "smoke": "TMC_SMOKE=1 electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac --x64 --arm64 && electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --x64 --arm64",
    "dist:win": "electron-builder --win --x64"
  },
  "keywords": [
    "tmc",
    "electron",
    "debug"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "qrcode-generator": "^2.0.4"
  },
  "build": {
    "appId": "cn.movatrip.tmc.tool",
    "productName": "TMC调试工具",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "renderer/assets/tmc-logo.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "sign": false,
      "title": "${productName} ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "TMC调试工具",
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    }
  }
}
