{
  "name": "tmc-tool",
  "version": "1.6.2",
  "description": "TMC 机票 / 酒店 查询、下单、支付桌面调试工具",
  "productName": "TMC调试工具",
  "main": "main.js",
  "scripts": {
    "prestart": "node scripts/set-macos-app-name.js",
    "start": "electron .",
    "presmoke": "node scripts/set-macos-app-name.js",
    "smoke": "TMC_SMOKE=1 electron .",
    "pack": "electron-builder --dir",
    "dist": "npm run dist:mac",
    "dist:mac": "electron-builder --mac --arm64 --publish never"
  },
  "keywords": [
    "tmc",
    "electron",
    "debug"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "qrcode-generator": "^2.0.4"
  },
  "build": {
    "appId": "cn.movatrip.tmc.tool",
    "productName": "TMC调试工具",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "updater.js",
      "renderer-origin.js",
      "renderer-update.js",
      "renderer-update-public.pem",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "afterPack": "./scripts/sign-mac-adhoc.js",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "renderer/assets/tmc-logo.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "sign": false,
      "title": "${productName} ${version}"
    }
  }
}
